# Copie para .env e preencha com os valores reais (nunca commitar o .env)

# API key do Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo Gemini a usar (precisa suportar function calling)
GEMINI_MODEL=gemini-3.8-flash

# URL do mcp_server (o outro serviço deste desafio)
MCP_SERVER_URL=http://localhost:3001

# Mesmo token configurado no MCP_AUTH_TOKEN do mcp_server
MCP_AUTH_TOKEN=dev-secret-token
