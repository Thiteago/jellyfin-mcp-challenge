# Copie para .env e preencha com os valores reais (nunca commitar o .env)

# URL base da sua instância Jellyfin, ex: http://192.168.1.10:8096
JELLYFIN_URL=

# API key gerada em Painel Admin > Avançado > API Keys
JELLYFIN_API_KEY=

# ID do usuário Jellyfin cujas tools vão operar (favoritos, filtros de assistido/não-assistido)
JELLYFIN_USER_ID=

# Token que o agent_api precisa enviar no header Authorization: Bearer <token>
MCP_AUTH_TOKEN=dev-secret-token

# URL base da sua instância Seerr, ex: http://192.168.1.10:5055
SEERR_URL=

# API key gerada em Seerr > Configurações > Geral
SEERR_API_KEY=
